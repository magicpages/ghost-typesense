{
  "name": "@magicpages/ghost-typesense-webhook",
  "version": "2.3.1",
  "description": "Webhook handler for real-time Ghost content synchronization with Typesense",
  "author": "MagicPages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicpages/ghost-typesense.git",
    "directory": "apps/webhook-handler"
  },
  "scripts": {
    "build": "tsup src/handler.ts --format cjs",
    "clean": "rimraf dist",
    "dev": "tsup src/handler.ts --format cjs --dts --watch",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@magicpages/ghost-typesense-config": "^2.3.1",
    "@magicpages/ghost-typesense-core": "^2.3.1",
    "@netlify/functions": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.0.1",
    "rimraf": "^6.1.3",
    "vitest": "^4.1.11",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
