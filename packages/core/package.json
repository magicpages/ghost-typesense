{
  "name": "@magicpages/ghost-typesense-core",
  "version": "2.5.0",
  "description": "Core functionality for Ghost-Typesense integration",
  "author": "MagicPages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicpages/ghost-typesense.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "clean": "rimraf dist",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@magicpages/ghost-typesense-config": "^2.5.0",
    "@ts-ghost/content-api": "5.0.0",
    "@ts-ghost/core-api": "^7.0.0",
    "typesense": "^3.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "rimraf": "^6.1.3",
    "tsup": "^9.0.0",
    "typescript": "^5.3.3",
    "vitest": "^5.0.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
