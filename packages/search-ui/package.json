{
  "name": "@magicpages/ghost-typesense-search-ui",
  "version": "2.5.0",
  "description": "A vanilla JavaScript search UI for Ghost + Typesense integration",
  "type": "module",
  "main": "dist/search.min.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.{js,css}",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ghost",
    "typesense",
    "search",
    "ui"
  ],
  "author": "MagicPages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicpages/ghost-typesense.git",
    "directory": "packages/search-ui"
  },
  "dependencies": {
    "typesense": "3.0.6"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "cssnano": "^9.9.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "rollup": "^4.65.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
